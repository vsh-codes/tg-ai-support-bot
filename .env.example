# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AAEexampleexampleexampleexampleexample

# Your Telegram user ID (numeric) — get from @userinfobot
# This account receives escalation pings and admin commands.
ADMIN_CHAT_ID=123456789

# Anthropic API key — get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXX

# Claude model — default is Haiku for cost efficiency.
# For higher-stakes conversations switch to: claude-sonnet-4-5
CLAUDE_MODEL=claude-haiku-4-5

# Name of your company — used in the system prompt.
COMPANY_NAME=Your Company

# Path to the knowledge base directory (relative to project root)
KNOWLEDGE_DIR=knowledge

# How many conversation turns to keep as context (each turn = user + assistant message)
MAX_HISTORY_TURNS=10

# How many knowledge base chunks to retrieve per query
RAG_TOP_K=3

# Max messages per user per hour (rate limit)
RATE_LIMIT_PER_HOUR=30

# Local SQLite path for conversation history
DATABASE_PATH=data/bot.db

# Logging
LOG_LEVEL=INFO
